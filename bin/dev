#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PROGRAM="${PROGRAM:-programs/rv32i_all.hex}"
VERILOG_DIR="${VERILOG_DIR:-output/verilog}"
SIM="output/pipeline5_sim.out"
TESTBENCH="app/sim/tb_pipeline5.v"
SBT_KEY_URL="https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x2EE0EA64E40A89B84B2DF73499E82A75642AC823"

cd "$ROOT"

need() {
  command -v "$1" >/dev/null || {
    echo "Comando ausente: $1" >&2
    exit 1
  }
}

building() {
  need sbt
  need iverilog
  need vvp
  test -f "$PROGRAM" || { echo "Programa ausente: $PROGRAM" >&2; exit 1; }
  rm -rf "$VERILOG_DIR"
  mkdir -p output
  # Processo isolado: nao reutiliza um servidor sbt com `test` pendente.
  sbt --no-server "runMain riscv.pipeline.GeneratePipeline5Verilog $PROGRAM $VERILOG_DIR"
  iverilog -g2012 -o "$SIM" "$VERILOG_DIR/Pipeline5.v" "$TESTBENCH"
  vvp "$SIM"
}

run() {
  need gtkwave
  test -f output/pipeline.vcd || {
    echo "Arquivo ausente: output/pipeline.vcd. Execute npm run building primeiro." >&2
    exit 1
  }
  if [[ -z "${DISPLAY:-}" && -z "${WAYLAND_DISPLAY:-}" ]]; then
    echo "GTKWave nao abriu porque esta sessao nao possui DISPLAY/WAYLAND_DISPLAY."
    echo "Arquivo disponivel: output/pipeline.vcd"
    return
  fi
  nohup env -u LD_LIBRARY_PATH -u LD_PRELOAD "$(command -v gtkwave)" \
    "$ROOT/output/pipeline.vcd" >output/gtkwave.log 2>&1 &
  echo "GTKWave aberto; log em output/gtkwave.log"
}

linter() {
  need sbt
  sbt scalafmtCheckAll
}

test() {
  need sbt
  sbt test
}

setup() {
  need apt-get

  if (( EUID == 0 )); then
    SUDO=()
  else
    need sudo
    SUDO=(sudo)
  fi

  apt_update() {
    if ! "${SUDO[@]}" apt-get update; then
      echo "Aviso: um repositorio externo falhou; continuando com os repositorios validos." >&2
    fi
  }

  apt_update
  "${SUDO[@]}" apt-get install -y curl gnupg ca-certificates iverilog gtkwave

  if ! command -v java >/dev/null || ! java -version 2>&1 | grep -q '"21'; then
    "${SUDO[@]}" apt-get install -y openjdk-21-jdk
  fi

  if ! command -v sbt >/dev/null; then
    "${SUDO[@]}" install -d -m 0755 /etc/apt/keyrings
    curl -fsSL "$SBT_KEY_URL" |
      "${SUDO[@]}" gpg --dearmor --yes -o /etc/apt/keyrings/scalasbt.gpg
    printf '%s\n' \
      'deb [signed-by=/etc/apt/keyrings/scalasbt.gpg] https://repo.scala-sbt.org/scalasbt/debian all main' |
      "${SUDO[@]}" tee /etc/apt/sources.list.d/sbt.list >/dev/null
    apt_update
    "${SUDO[@]}" apt-get install -y sbt
  fi

  echo "Ambiente pronto: Java, sbt, Icarus Verilog e GTKWave."
}

case "${1:-}" in
  setup|building|run|linter|test) "$1" ;;
  *) echo "Uso: pnpm run {setup|building|run|linter|test}" >&2; exit 2 ;;
esac
